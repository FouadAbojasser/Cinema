@using Cinema.Models.ViewModels
@model IEnumerable<ApplicationUserVM>

<div class="row">
	<div class="col-md-12">
		<div class="card">
			<div class="table-responsive pt-3">
				<table class="table table-striped project-orders-table">
					<thead>
						<tr>
							<th class="ml-5">No.</th>
							<th>Image</th>
							<th>User Name</th>
							<th>Date of Birth</th>
							<th>Email</th>
							<th>Email Confirmed</th>
							<th>User Roles</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						@{
							int count = 1;
						}
						@foreach (var userVM in Model)
						{
							<tr>
								<td>@(count++)</td>
								<td class="py-1">
									<img src="~/img/users/@userVM.ApplicationUser.Image" alt="image"
									style="width: 50px; height: 50px; border-radius: 50%; object-fit: cover;" />
								</td>
								<td align="center">@userVM.ApplicationUser.UserName</td>
								<td align="center">@userVM.ApplicationUser.DoB.ToString("dd-MMM-yyyy")</td>
								<td>@userVM.ApplicationUser.Email</td>
								<td align="center">@userVM.ApplicationUser.EmailConfirmed</td>
								<td>
									@foreach (var role in @userVM.UserRoles)
									{
										<p>@role</p>
									}
								</td>
								<td>
									<div class="d-flex align-items-center">
										<a href="/Admin/Users/Edit/@userVM.ApplicationUser.Id" class="btn btn-success btn-sm btn-icon-text mr-3">
											Edit
											<i class="typcn typcn-edit btn-icon-append"></i>
										</a>

										<a href="javascript:void(0);" onclick="confirmDelete('@userVM.ApplicationUser.Id')" class="btn btn-danger btn-sm btn-icon-text">
											Delete
											<i class="typcn typcn-delete-outline btn-icon-append"></i>
										</a>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>

