@using Cinema.Models.ViewModels
@model TheaterWithScheduleVM
<div class="col-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Edit Show Schedule for: @Model.Theater!.Name</h4>


            <form method="post" action="/Admin/Theaters/EditSchedule">

                <div class="form-group">
                    <label for="Name">Cinema Name</label>
                    <input type="text" readonly class="form-control" asp-for="@Model.Theater!.Name">
                    <input type="hidden" class="form-control" asp-for="@Model.Theater.Id">
                    <input type="hidden" class="form-control" asp-for="@Model.TheaterSchedule!.Id">
                </div>

                <div class="form-group">
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                Select Movie
                            </button>
                            <div class="dropdown-menu">
                                @foreach (var movie in Model.Theater.Movies)
                                {
                                        <a class="dropdown-item movie-option" href="#" data-id="@movie.Id" data-title="@movie.Title">@movie.Title</a>
                                }
                            </div>
                        </div>

                        <!-- Visible input for movie title -->
                        <input type="text" id="movieTitleInput" asp-for="@Model.TheaterSchedule!.Movie!.Title" value="@Model.Theater.Movies.FirstOrDefault(m=>m.Id==Model.TheaterSchedule!.MovieId)!.Title" class="form-control" readonly>

                        <!-- Hidden input for movie ID bound to the model -->
                        <input type="hidden" asp-for="TheaterSchedule.MovieId" id="movieIdInput" />

                       
                    </div>
                </div>



                <div class="form-group row">
                    <label for="SelectedDate">Select Day</label>
                    <input type="date" class="form-control" asp-for="@Model.TheaterSchedule!.ShowDate" placeholder="dd/mm/yyyy" />
                </div>


                <div class="form-group">
                    <label for="SelectedTime">Select Time</label>
                    <input type="time" class="form-control" asp-for="@Model.TheaterSchedule!.ShowTimeFrom"/>
                </div>


                <button id="submitBtn" type="submit" class="btn btn-primary mr-2">Submit</button>

                <a href="/Admin/Theaters/Schedule/@Model.Theater.Id" class="btn btn-light">Cancel</a>

            </form>

        </div>
    </div>
</div>

@section Scripts {
        <partial name="_ValidationScriptsPartial">
    }

    <script>
        const form = document.getElementById("myForm");

        form.addEventListener("submit", function (e) {
            e.preventDefault(); // Prevent immediate submit

            // Check if the form is valid using jQuery Unobtrusive Validation
            if ($(form).valid()) {
                // Store the flag in localStorage
                // localStorage.setItem("showSuccessAlert", "true");

                // Submit the form
                form.submit();
            }
            // else: don't show alert or submit the form
        });
    </script>


    <script>
        document.querySelectorAll('.movie-option').forEach(function (item) {
            item.addEventListener('click', function (e) {
                e.preventDefault();
                const movieId = this.getAttribute('data-id');
                const movieTitle = this.getAttribute('data-title');

                // Set title to visible input
                document.getElementById('movieTitleInput').value = movieTitle;

                // Set ID to hidden input (bound to the model)
                document.getElementById('movieIdInput').value = movieId;
            });
        });
    </script>

