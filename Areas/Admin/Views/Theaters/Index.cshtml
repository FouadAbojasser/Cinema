@model IEnumerable<Theater>

<div class="row">
	<div class="col-md-12">
		<div class="card">
			<div class="table-responsive pt-3">
				<table class="table table-striped project-orders-table">
					<thead>
						<tr>
							<th class="ml-5">ID</th>
							<th>Theater Name</th>
							<th>Address</th>
							<th style="text-align:center">Rate</th>
							<th style="text-align:center">No. of Seats</th>
							<th style="text-align:center">No. of Movies</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						@{
							int count = 1;
						}
						@foreach (var theater in Model)
						{

							<tr>
								<td>@(count++)</td>
								<td>@theater.Name</td>
								<td>@theater.Address</td>
								<td style ="text-align:center">@theater.Rate</td>
								<td style="text-align:center">@theater.Seats</td>
								<td style="text-align:center">@theater.MovieTheater.Count()</td>
								<td>

									<div class="d-flex align-items-center">
										<a href="/Admin/Theaters/Edit/@theater.Id" class="btn btn-success btn-sm btn-icon-text mr-3">
											Edit
											<i class="typcn typcn-edit btn-icon-append"></i>
										</a>

										<a href="javascript:void(0);" onclick="confirmDelete(@theater.Id)" class="btn btn-danger btn-sm btn-icon-text">
											Delete
											<i class="typcn typcn-delete-outline btn-icon-append"></i>
										</a>
									</div>

								</td>
							</tr>

						}


					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>

<!-- partial:partials/_settings-panel.html -->
<a id="settings-trigger" href="/Admin/Theaters/Create">
	<h5 style="color: aliceblue; vertical-align:central; margin:0px">+</h5>
</a>

<script>
	function confirmDelete(id) {
		Swal.fire({
			title: "Are you sure you want to delete this Theater?",
			text: "You won't be able to revert this!",
			icon: "warning",
			showCancelButton: true,
			confirmButtonColor: "#3085d6",
			cancelButtonColor: "#d33",
			confirmButtonText: "Yes, delete it!"
		}).then((result) => {
			if (result.isConfirmed) {
				// Redirect to delete action
				setTimeout(() => {
					window.location.href = `/Admin/Theaters/Delete/${id}`;
				}, 1500); // Wait for the alert to finish
			}
		});
	}
</script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


@if (TempData["SuccessMessage"] != null)
{
	<script>
		Swal.fire({
			position: "center",
			icon: "success",
			title: "@TempData["SuccessMessage"]",
			showConfirmButton: false,
			timer: 1500
		});
	</script>
}
